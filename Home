    <style>
        body { font-family: Arial, sans-serif; background-color: #121212; color: #ffffff; margin: 0; padding: 0; text-align: center; }
        header { padding: 50px 20px; background: #1f1f1f; }
        h1 { margin: 0; font-size: 2.5em; color: #ff4757; }
        p { color: #a4b0be; font-size: 1.2em; }
        .container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
        .video-card { background: #1f1f1f; margin-bottom: 30px; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        .video-wrapper { position: relative; padding-bottom: 56.25%; height: 0; }
        .video-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
        .video-info { padding: 20px; text-align: left; }
        .video-info h3 { margin: 0 0 10px 0; }
        footer { padding: 20px; background: #1f1f1f; color: #747d8c; margin-top: 50px;}
    </style>
</head>
