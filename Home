    <div class="container">
        <h2>Featured Showreel</h2>
        <!-- Replace the src link with your own YouTube/Vimeo embed link -->
        <div class="video-card">
            <div class="video-wrapper">
                <iframe src="https://www.youtube.com/embed/YOUR_VIDEO_ID" allowfullscreen></iframe>
            </div>
            <div class="video-info">
                <h3>Main Showreel 2026</h3>
                <p>A compilation of commercial edits, narrative cuts, and dynamic color grading.</p>
